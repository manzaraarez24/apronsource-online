rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Storefront: anyone can browse products; only a logged-in admin can change them.
    match /products/{productId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Checkout: customers (not logged in) can place an order but can't read others' orders.
    // Admin panel (logged in) can read and manage all orders.
    match /orders/{orderId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // Anything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
